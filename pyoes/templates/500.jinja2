{% extends "layout.jinja2" %}

{% set mailto_error = mailto_error|default('ict@onroerenderfgoed.be') -%}
{% set app_package = app_package|default('Pyoes') %}

{% block html_title %}Page not found | {{app_package}} | Onroerend Erfgoed{% endblock %}

{% block content %}
  <main class="vl-grid vl-u-spacer-top vl-u-spacer-bottom">
    <div class="vl-col--1-1">
      <div class="vl-u-align-center vl-u-spacer-bottom">
        <h1 class="vl-title vl-title--h1">
          <span class="vl-vi vl-vi-warning" aria-hidden="true"></span>
          <span>500</span>
        </h1>
        <h2 class="vl-title vl-title--h3">Er is een technisch probleem.</h2>
        <p class="vl-title vl-title--h4"><strong>Sorry! Onze website heeft een technisch probleem. Hierdoor kan je deze pagina niet raadplegen.</strong></p>
      </div>
      <section class="vl-info-tile vl-typography">
        <h2 class="vl-title vl-title--h5">Wat kan je zelf doen?</h2>
        <ul>
          <li><strong>Vernieuw de browserpagina <small>(CTRL+F5 of CMD+R)</small></strong></li>
          <li><strong>Wis de browsergeschiedenis en geef de URL opnieuw in.</strong></li>
          <li><strong>Meld ons het technisch probleem via <a class="vl-link" href="mailto:{{ mailto_error }}">{{ mailto_error }}</a>.</strong><br>
            Vergeet niet te vermelden welke pagina je zocht, welk besturingsysteem (Windows, MacOS, ... ) en welke browser ( Chrome, ... ).</li>
          <li><strong>Je kan een nieuwe zoekopdracht starten op de <a class="vl-link" href="/">homepagina.</a></strong></li>
        </ul>
      </section>
    </div>
  </main>
{% endblock %}