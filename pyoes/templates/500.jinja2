{% extends "layout.jinja2" %}

{% set mailto_error = mailto_error|default('ict@onroerenderfgoed.be') -%}
{% set app_package = app_package|default('Pyoes') %}

{% block html_title %}Technisch probleem | {{ app_package }} | Onroerend Erfgoed{% endblock %}

{% block content %}
<div class="vl-typography oe-error-page">
  <h1 class="vl-title vl-title--h1">500 - Er is een technisch probleem.</h1>
  <p class="vl-introduction">Sorry! Onze website heeft een technisch probleem. Hierdoor kan je deze pagina niet raadplegen.</p>
  <h2 class="vl-title vl-title--h3">Wat kan je zelf doen?</h2>
  <ul>
    <li><strong>Vernieuw de browserpagina</strong> <small>(CTRL+F5 of CMD+R)</small>.</li>
    <li><strong>Wis de browsergeschiedenis</strong> en geef de URL opnieuw in.</li>
    <li><strong>Meld ons het technisch probleem</strong> via <a class="vl-link" href="mailto:{{ mailto_error }}">{{ mailto_error }}</a>. Vergeet niet te vermelden welke pagina je zocht, welk besturingssysteem (Windows, MacOS, ...) en welke browser (Chrome, ...).</li>
    <li>Je kan een nieuwe zoekopdracht starten op de <a class="vl-link" href="/">homepagina</a>.</li>
  </ul>
</div>
{% endblock %}