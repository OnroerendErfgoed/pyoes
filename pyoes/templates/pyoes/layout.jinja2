<!doctype html>
<html class="no-js" lang="nl">
{#
  Algemene pyoes layout op basis van Webuniversum.

  Structuur:
    .vl-page
      [burgerprofiel-header]                 block vlaanderen_header
      header.vl-application-header           block header (pyoes/header.jinja2)
      main.vl-main-content                   block main
        .vl-region > .vl-layout
          block messages
          block content
      #footerContainer                       block vlaanderen_footer, block footer
    block javascript

  Instelbare variabelen (zet ze in je eigen layout.jinja2):
    app_package           pakket dat static/css/app.css levert (default 'pyoes')
    css_files, js_files   lijsten met te laden css/js (default: enkel app.css, geen js)
    active_title          titel in de header
    home_link             link achter de titel
    header_links          lijst van (tekst, href, title) rechtsboven in de header
    main_nav              lijst van (id, caption, href[, class]) in de hoofdnavigatie
    dropdown_main_nav     lijst van (id, caption, [(id, caption, href), ...])
    active_main_nav       id van het actieve navigatie-item
    nav_actions           lijst van (caption, href) rechts in de hoofdnavigatie
#}
{% set app_package = app_package|default('pyoes', true) -%}
{% set active_title = active_title -%}

{% set main_nav = main_nav -%}
{% set dropdown_main_nav = dropdown_main_nav -%}
{% set active_main_nav = active_main_nav -%}
{% set nav_actions = nav_actions -%}
{% set home_link = home_link -%}
{% set header_links = header_links -%}
{% set plausible_domain_hash = plausible_domain_hash|default(request.registry.settings["plausible.domain_hash"]) -%}
{% set plausible_omgeving = plausible_omgeving|default("dev") -%}
{% set plausible_custom_init = plausible_custom_init|default(None) -%}
{% set burgerprofiel_header_id = burgerprofiel_header_id|default(request.registry.settings["burgerprofiel.header_id"]) -%}
{% set burgerprofiel_footer_id = burgerprofiel_footer_id|default(request.registry.settings["burgerprofiel.footer_id"]) -%}
{% set home_route = request.route_path('home') -%}

<head>
  {% block html_header scoped %}
    <!-- head -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block html_title %}Onroerend Erfgoed{% endblock %}</title>
    {% if plausible_omgeving in ('dev', 'test') %}
    <meta name="robots" content="noindex" />
    {% endif %}

    {% block css scoped -%}
      <!-- css -->
      {% set default_css_files = [
        request.static_path(app_package + ':static/css/app.css')
      ] -%}
      {% set css_files = css_files|default(default_css_files) -%}
      {% for css in css_files -%}
        <link rel="stylesheet" href="{{ css }}"/>
      {% endfor -%}
    {% endblock -%}
  {% endblock %}

  {% block plausible -%}
    {% if plausible_domain_hash %}
      {% from 'pyoes/macros.jinja2' import plausible_tracker %}
      {{ plausible_tracker(plausible_domain_hash, plausible_omgeving, plausible_custom_init) }}
    {% endif %}
  {% endblock %}
</head>
<body>
<div class="vl-page">
  {% block vlaanderen_header scoped %}
    {% if burgerprofiel_header_id %}
      {% if request.registry.settings['pyoes.banner'] %}
        {% from 'pyoes/macros.jinja2' import render_info_banner %}
        {{ render_info_banner(request.registry.settings['pyoes.banner'], request.registry.settings['pyoes.banner.detail']) }}
      {% endif %}
      <div class="vlaanderen-header-container">
        {% from 'pyoes/macros.jinja2' import render_vlaanderen_header %}
        {% set pyoes_banner = {
          'banner': request.registry.settings.get('pyoes.banner'),
          'detail': request.registry.settings.get('pyoes.banner.detail')
        } %}
        {{ render_vlaanderen_header(plausible_omgeving, burgerprofiel_header_id, pyoes_banner, request.authenticated_userid, home_route) }}
      </div>
    {% else %}
      <script src="//widgets.vlaanderen.be/widget/live/37de485347434fbdaa70e0c03eb48d01"></script>
    {% endif %}
    {% block custom_contact_info scoped %}
    {% endblock %}
  {% endblock %}

  {% block header scoped %}
    {% include "pyoes/header.jinja2" %}
  {% endblock %}

  <main class="vl-main-content" id="main">
    {% block main scoped %}
      <section class="vl-region">
        <div class="vl-layout">
          {% block messages scoped %}
          {% endblock %}

          {% block content scoped %}
          {% endblock %}
        </div>
      </section>
    {% endblock %}
  </main>

  <div id="footerContainer">
    {% block vlaanderen_footer scoped %}
      {% if burgerprofiel_footer_id %}
          {% from 'pyoes/macros.jinja2' import render_vlaanderen_footer %}
          {{ render_vlaanderen_footer(plausible_omgeving, burgerprofiel_footer_id) }}
      {% else %}
        <script src="//widgets.vlaanderen.be/widget/live/d619177b83734bf7b5bb596ff7e6c41e"></script>
      {% endif %}
    {% endblock %}

    {% block footer scoped %}
    {% endblock %}
  </div>
</div>

{% block javascript scoped -%}
  <!-- javascript -->
  {# De shell heeft geen javascript nodig (het uitklapmenu werkt met <details>).
     Zet js_files in je eigen layout om scripts onderaan de pagina te laden. #}
  {% set js_files = js_files|default([]) -%}
  {% for js in js_files -%}
    <script src="{{ js }}"></script>
  {% endfor -%}
{% endblock -%}
</body>
</html>
