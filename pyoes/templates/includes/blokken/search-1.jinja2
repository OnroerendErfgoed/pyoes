<section aria-labelledby="search-title">
  <header class="vl-sidebar-header">
    <h2 id="search-title" class="vl-title vl-title--h3 vl-sidebar-header__title">Zoeken</h2>
  </header>
  <div class="vl-sidebar-content">
  <form action="#" method="post" class="vl-form">
    <div class="vl-search vl-search--alt vl-input-group">
      <input class="vl-input-field vl-input-field--block" id="search-query" type="search" placeholder="zoek" aria-label="Zoekterm">
      <button class="vl-input-addon" type="submit" aria-label="Zoeken">
        <span class="vl-vi vl-vi-search" aria-hidden="true"></span>
      </button>
    </div>

    <fieldset class="vl-u-spacer-top--xsmall">
      <legend class="vl-form__label">Zoek binnen</legend>
      <div class="vl-checkbox vl-u-spacer-bottom--xsmall">
        <input class="vl-checkbox__toggle" id="search-site" type="checkbox">
        <label class="vl-checkbox__label" for="search-site">
          <span class="vl-checkbox__box" aria-hidden="true"></span>
          zoek binnen deze website
        </label>
      </div>
      <div class="vl-checkbox">
        <input class="vl-checkbox__toggle" id="search-flanders" type="checkbox">
        <label class="vl-checkbox__label" for="search-flanders">
          <span class="vl-checkbox__box" aria-hidden="true"></span>
          zoek binnen Vlaanderen.be
        </label>
      </div>
    </fieldset>
  </form>
  </div>
</section>
