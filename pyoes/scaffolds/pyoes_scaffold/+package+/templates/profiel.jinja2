{% extends "layout.jinja2" %}
{% set app_package = app_package|default('Pyoes') %}

{% block html_title %}Profiel | {{app_package}} | Onroerend Erfgoed{% endblock %}

{% block content %}
<div class="row">
    <div class="large-12 columns">
        <div class="panel">
            <h3>Uw profiel</h3>

            {% if not pyoes.user or not pyoes.user.userid %}
              <div class="alert">
              U bent niet aangemeld.
              </div>
            {% else %}
              {% if pyoes.user.actor %}
                <p>U bent aangemeld als <strong>{{ pyoes.user.actor.omschrijving }}</strong>.</p>
              {% else %}
                <p>U bent aangemeld als <strong>{{ pyoes.user.userid }}</strong>.</p>
              {% endif %}
              <p>U beschikt over volgende rollen:</p>
              <ul>
              {% if pyoes.user.groups %}
                {% for rol in pyoes.user.groups %}
                    <li><em>{{ rol }}</em></li>
                {% endfor %}
              {% endif %}
              </ul>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}